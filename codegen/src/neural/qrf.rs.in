//! Native THS_PTF01 inference from an external PTFKQF01 artifact.
use super::ModelError;
use sha2::{Digest, Sha256};
use std::{io::Read, path::Path};

const SHA256: &str = "@QRF_SHA256@";
const MAX_BYTES: usize = 64 * 1024 * 1024;

#[derive(Debug)]
struct Node { left: usize, right: usize, feature: usize, value: f64, sample: f64 }

/// EU-PTF v2 THS_PTF01. Parameters are imported locally and are never bundled.
#[derive(Debug)]
pub struct Euptf2Ths { trees: Vec<Vec<Node>>, features: usize }

impl Euptf2Ths {
    /// Authenticate the exact reviewed THS_PTF01 container and own its data.
    pub fn from_bytes(bytes: &[u8]) -> Result<Self, ModelError> {
        Self::decode(bytes, SHA256)
    }

    /// Load the externally imported THS_PTF01 model.
    pub fn load(path: impl AsRef<Path>) -> Result<Self, ModelError> {
        let mut bytes = Vec::new();
        std::fs::File::open(path).map_err(ModelError::Io)?.take((MAX_BYTES + 1) as u64)
            .read_to_end(&mut bytes).map_err(ModelError::Io)?;
        Self::from_bytes(&bytes)
    }

    fn decode(bytes: &[u8], expected: &str) -> Result<Self, ModelError> {
        if bytes.len() < 16 || bytes.len() > MAX_BYTES { return Err(ModelError::Format); }
        let actual: String = Sha256::digest(bytes).iter().map(|v| format!("{v:02x}")).collect();
        if actual != expected { return Err(ModelError::Integrity); }
        let mut r = super::Reader { data: bytes, pos: 0 };
        if &r.bytes::<8>()? != b"PTFKQF01" || r.u32()? != 1 { return Err(ModelError::Format); }
        Self::read_forest(&mut r, 4).and_then(|model| {
            if r.pos != bytes.len() { Err(ModelError::Format) } else { Ok(model) }
        })
    }

    fn read_forest(r: &mut super::Reader<'_>, features: usize) -> Result<Self, ModelError> {
        let count = r.u32()?;
        if !(1..=1000).contains(&count) { return Err(ModelError::Format); }
        let mut trees = Vec::with_capacity(count);
        for _ in 0..count {
            let n = r.u32()?;
            if n == 0 || n > (r.data.len() - r.pos) / 28 { return Err(ModelError::Format); }
            let mut nodes = Vec::with_capacity(n);
            let mut parents = vec![0u8; n];
            for index in 0..n {
                let left = r.u32()?;
                let right = r.u32()?;
                let feature = r.u32()?;
                let value = r.f64()?;
                let sample = r.f64()?;
                if left == 0 && right == 0 {
                    if feature != u32::MAX as usize { return Err(ModelError::Format); }
                } else {
                    if left <= index || right <= index || left >= n || right >= n || left == right || feature >= features || sample != 0.0 {
                        return Err(ModelError::Format);
                    }
                    for child in [left,right] {
                        if parents[child] != 0 { return Err(ModelError::Format); }
                        parents[child] = 1;
                    }
                }
                nodes.push(Node { left, right, feature, value, sample });
            }
            if parents[1..].iter().any(|p| *p != 1) { return Err(ModelError::Format); }
            trees.push(nodes);
        }
        Ok(Self { trees, features })
    }

    /// Return mean and conditional quantiles at 0.05, 0.5, 0.95, in cm3/cm3.
    /// Inputs: USDA sand, silt, clay in mass percent, mean depth in cm.
    /// NaN is missing and rejected; no imputation, clipping or renormalization.
    pub fn predict(&self, inputs: [f64; 4]) -> Result<[f64; 4], ModelError> {
        let (mean, q) = self.statistics(&inputs, &[0.05, 0.5, 0.95])?;
        Ok([mean, q[0], q[1], q[2]])
    }

    fn statistics(&self, inputs: &[f64], probabilities: &[f64]) -> Result<(f64, Vec<f64>), ModelError> {
        if inputs.len() != self.features || inputs.iter().any(|v| v.is_nan()) { return Err(ModelError::Input); }
        let mut mean = 0.0;
        let mut samples = Vec::with_capacity(self.trees.len());
        for tree in &self.trees {
            let mut node = &tree[0];
            while node.left != 0 {
                node = &tree[if inputs[node.feature] <= node.value { node.left } else { node.right }];
            }
            mean += node.value;
            samples.push(node.sample);
        }
        samples.sort_by(f64::total_cmp);
        let quantile = |p: f64| {
            let h = (samples.len() - 1) as f64 * p;
            let lo = h.floor() as usize;
            let hi = h.ceil() as usize;
            let g = h - lo as f64;
            if lo == hi || samples[lo] == samples[hi] { samples[lo] }
            else { (1.0 - g) * samples[lo] + g * samples[hi] }
        };
        Ok((mean / self.trees.len() as f64, probabilities.iter().map(|p| quantile(*p)).collect()))
    }
}


/// Scientific identity of an external EU-PTF v2 trained object.
#[derive(Debug)]
pub struct Euptf2Descriptor {
    pub name: &'static str,
    pub inputs: &'static [&'static str],
    pub mean_outputs: &'static [&'static str],
    pub quantile_outputs: &'static [&'static str],
    pub(crate) id: usize,
    sha256: &'static str,
    transforms: &'static [u32],
}
@EUPTF2_RUST_CONTRACTS@

/// Enumerate the supported original trained objects, not the 32 selection aliases.
pub fn euptf2_models() -> &'static [Euptf2Descriptor] { EUPTF2_MODELS }

/// Original-scale point estimates and parameter-major conditional quantiles.
/// VG/MVG include derived M in means only, exactly as the original R package.
#[derive(Debug)]
pub struct Euptf2Prediction {
    pub mean: Vec<f64>,
    pub quantiles: Vec<Vec<f64>>,
    pub probabilities: Vec<f64>,
}

/// An authenticated original EU-PTF v2 object, containing one or more QRFs.
#[derive(Debug)]
pub struct Euptf2Model {
    descriptor: &'static Euptf2Descriptor,
    forests: Vec<Euptf2Ths>,
}

fn output_transform(value: f64, transform: u32) -> f64 {
    match transform {
        0 => value, 1 => 10.0_f64.powf(value), 2 => 10.0_f64.powf(value)-1.0,
        3 => 10.0_f64.powf(value)+1.0, _ => unreachable!(),
    }
}

impl Euptf2Model {
    pub fn descriptor(&self) -> &'static Euptf2Descriptor { self.descriptor }
    /// Authenticate the entire PTFKQF02 container against the selected model.
    pub fn from_bytes(name: &str, bytes: &[u8]) -> Result<Self, ModelError> {
        let descriptor = EUPTF2_MODELS.iter().find(|m| m.name == name).ok_or(ModelError::Input)?;
        if bytes.len() < 20 || bytes.len() > MAX_BYTES { return Err(ModelError::Format); }
        let sha: String = Sha256::digest(bytes).iter().map(|v| format!("{v:02x}")).collect();
        if sha != descriptor.sha256 { return Err(ModelError::Integrity); }
        Self::parse(descriptor, bytes)
    }
    fn parse(descriptor: &'static Euptf2Descriptor, bytes: &[u8]) -> Result<Self, ModelError> {
        let mut r = super::Reader { data: bytes, pos: 0 };
        if &r.bytes::<8>()? != b"PTFKQF02" || r.u32()? != descriptor.id
            || r.u32()? != descriptor.inputs.len() || r.u32()? != descriptor.transforms.len() {
            return Err(ModelError::Format);
        }
        let mut forests = Vec::new();
        for transform in descriptor.transforms {
            if r.u32()? != *transform as usize { return Err(ModelError::Format); }
            forests.push(Euptf2Ths::read_forest(&mut r, descriptor.inputs.len())?);
        }
        if r.pos != bytes.len() { return Err(ModelError::Format); }
        Ok(Self { descriptor, forests })
    }
    pub fn load(name: &str, path: impl AsRef<Path>) -> Result<Self, ModelError> {
        let mut bytes = Vec::new();
        std::fs::File::open(path).map_err(ModelError::Io)?.take((MAX_BYTES+1) as u64)
            .read_to_end(&mut bytes).map_err(ModelError::Io)?;
        Self::from_bytes(name, &bytes)
    }
    /// Mean and the original default .05/.25/.5/.75/.95 conditional quantiles.
    pub fn predict(&self, inputs: &[f64]) -> Result<Euptf2Prediction, ModelError> {
        self.predict_quantiles(inputs, &[0.05,0.25,0.5,0.75,0.95])
    }
    /// Between one and 64 probabilities, each strictly inside (0,1).
    /// Back-transform aggregated means and quantiles, never individual tree means.
    pub fn predict_quantiles(&self, inputs: &[f64], probabilities: &[f64]) -> Result<Euptf2Prediction, ModelError> {
        if probabilities.is_empty() || probabilities.len()>64 || probabilities.iter().any(|p| !(*p>0.0 && *p<1.0)) {
            return Err(ModelError::Input);
        }
        let mut mean = Vec::new();
        let mut quantiles = Vec::new();
        for (forest, transform) in self.forests.iter().zip(self.descriptor.transforms) {
            let (m, q) = forest.statistics(inputs, probabilities)?;
            mean.push(output_transform(m, *transform));
            quantiles.push(q.into_iter().map(|v| output_transform(v, *transform)).collect());
        }
        if self.descriptor.mean_outputs.len() > self.forests.len() {
            mean.push(1.0-1.0/mean[3]);
        }
        Ok(Euptf2Prediction { mean, quantiles, probabilities: probabilities.to_vec() })
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    fn fixture() -> Vec<u8> {
        // Two trees: depth <= 30 selects mean .4/sample .2, else .7/.9.
        // The other tree always returns mean .6/sample .8. Means and samples
        // intentionally differ, so quantiles of tree means cannot pass.
        let mut bytes = b"PTFKQF01".to_vec();
        for v in [1u32, 2, 3] { bytes.extend(v.to_le_bytes()); }
        for (left,right,feature,value,sample) in [
            (1u32,2u32,3u32,30.0f64,0.0f64),
            (0,0,u32::MAX,0.4,0.2), (0,0,u32::MAX,0.7,0.9),
        ] {
            for v in [left,right,feature] { bytes.extend(v.to_le_bytes()); }
            for v in [value,sample] { bytes.extend(v.to_le_bytes()); }
        }
        bytes.extend(1u32.to_le_bytes());
        for v in [0u32,0,u32::MAX] { bytes.extend(v.to_le_bytes()); }
        for v in [0.6f64,0.8] { bytes.extend(v.to_le_bytes()); }
        bytes
    }
    fn decode(bytes: &[u8]) -> Result<Euptf2Ths, ModelError> {
        let sha: String = Sha256::digest(bytes).iter().map(|v| format!("{v:02x}")).collect();
        Euptf2Ths::decode(bytes, &sha)
    }
    #[test]
    fn stored_response_quantiles_inclusive_depth_and_missing_input() {
        let bytes = fixture();
        let model = decode(&bytes).unwrap();
        for (depth, expected) in [(30.0,[0.5,0.23,0.5,0.77]), (30.0001,[0.65,0.805,0.85,0.895])] {
            let actual = model.predict([40.0,40.0,20.0,depth]).unwrap();
            for (a,e) in actual.into_iter().zip(expected) { assert!((a-e).abs() < 1e-14); }
        }
        assert!(matches!(model.predict([40.0,40.0,20.0,f64::NAN]), Err(ModelError::Input)));
        assert!(matches!(Euptf2Ths::from_bytes(&bytes), Err(ModelError::Integrity)));
    }
    #[test]
    fn authenticated_malformed_trees_are_rejected() {
        let original = fixture();
        let mut bad = Vec::new();
        for (offset,value) in [(8,2u32),(12,0),(16,u32::MAX),(20,0),(24,1),(28,4),(56,0)] {
            let mut b = original.clone(); b[offset..offset+4].copy_from_slice(&value.to_le_bytes()); bad.push(b);
        }
        let mut nonfinite = original.clone();
        nonfinite[68..76].copy_from_slice(&f64::NAN.to_le_bytes()); bad.push(nonfinite);
        bad.push(original[..original.len()-1].to_vec());
        let mut trailing = original.clone(); trailing.push(0); bad.push(trailing);
        for bytes in bad { assert!(matches!(decode(&bytes), Err(ModelError::Format))); }
    }
    #[test]
    fn multivariate_transforms_quantile_order_and_derived_m() {
        static CONTRACT: Euptf2Descriptor = Euptf2Descriptor {
            name:"synthetic", id:9, sha256:"", inputs:&["a","b","c","d","e","f","g","h","i"],
            mean_outputs:&["THS","THR","ALP","N","K0","L","M"],
            quantile_outputs:&["THS","THR","ALP","N","K0","L"], transforms:&[0,2,1,3,1,0],
        };
        let mut forest=fixture();
        forest[28..32].copy_from_slice(&8u32.to_le_bytes());
        let mut bytes=b"PTFKQF02".to_vec();
        for value in [9u32,9,6] { bytes.extend(value.to_le_bytes()); }
        for transform in CONTRACT.transforms { bytes.extend(transform.to_le_bytes()); bytes.extend(&forest[12..]); }
        let model=Euptf2Model::parse(&CONTRACT,&bytes).unwrap();
        let inputs=[0.,0.,0.,0.,0.,0.,0.,0.,30.];
        let prediction=model.predict(&inputs).unwrap();
        let root10=3.1622776601683795;
        let means=[0.5,root10-1.,root10,root10+1.,root10,0.5,1.-1./(root10+1.)];
        for (actual,expected) in prediction.mean.iter().zip(means) {assert!((actual-expected).abs()<1e-14);}
        assert_eq!(prediction.quantiles.len(),6);
        for (a,e) in prediction.quantiles[0].iter().zip([0.23,0.35,0.5,0.65,0.77]) {assert!((a-e).abs()<1e-14);}
        for (a,e) in prediction.quantiles[2].iter().zip([1.6982436524617444,2.2387211385683394,3.1622776601683795,4.466835921509632,5.88843655355589]) {assert!((a-e).abs()<1e-13);}
        let custom=model.predict_quantiles(&inputs,&[0.95,0.05,0.5]).unwrap();
        for (a,e) in custom.quantiles[0].iter().zip([0.77,0.23,0.5]) {assert!((a-e).abs()<1e-14);}
        for p in [vec![],vec![0.],vec![1.],vec![f64::NAN],vec![0.5;65]] {assert!(matches!(model.predict_quantiles(&inputs,&p),Err(ModelError::Input)));}
        assert!(matches!(model.predict(&inputs[..8]),Err(ModelError::Input)));
        for offset in [8,12,16,20] {let mut changed=bytes.clone(); changed[offset]^=1; assert!(matches!(Euptf2Model::parse(&CONTRACT,&changed),Err(ModelError::Format)));}
    }
}
