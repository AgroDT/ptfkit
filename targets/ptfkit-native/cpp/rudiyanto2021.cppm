    const double k49_o2 = -0.8315950555373025 * k49_h1 + 0.02326167555031614 * k49_h2 +
                          -0.6753294752534091 * k49_h3 + 2.971582658404609;
    const double t50_h1_linear = -3.117827539661164 * sand + 2.087621122725692 * silt +
                                 0.24376622728747252 * clay + -1.9351450915098876 * bulk_density +
                                 4.873333433722572;
    const double t50_h1_low = std::exp(2.0 * std::fmin(t50_h1_linear, 0.0));
    const double t50_h1_high = std::exp(-2.0 * std::fmax(t50_h1_linear, 0.0));
    const double t50_h1 = (t50_h1_low - t50_h1_high) / (t50_h1_low + t50_h1_high);
    const double t50_h2_linear = -0.33411860793097936 * sand + -5.971057242943911 * silt +
                                 12.560584364338634 * clay + 6.207769430040621 * bulk_density +
                                 -6.463396791014372;
    const double t50_h2_low = std::exp(2.0 * std::fmin(t50_h2_linear, 0.0));
    const double t50_h2_high = std::exp(-2.0 * std::fmax(t50_h2_linear, 0.0));
    const double t50_h2 = (t50_h2_low - t50_h2_high) / (t50_h2_low + t50_h2_high);
    const double t50_h3_linear = -3.5512097392934394 * sand + 4.678594787765855 * silt +
                                 -0.40920495841162197 * clay + 11.001786711330565 * bulk_density +
                                 -18.088047892024257;
    const double t50_h3_low = std::exp(2.0 * std::fmin(t50_h3_linear, 0.0));
    const double t50_h3_high = std::exp(-2.0 * std::fmax(t50_h3_linear, 0.0));
    const double t50_h3 = (t50_h3_low - t50_h3_high) / (t50_h3_low + t50_h3_high);
    const double t50_h4_linear = -0.35543166723906916 * sand + 0.7559052503045803 * silt +
                                 2.156973529826373 * clay + -1.935078378579 * bulk_density +
                                 0.26162460801519716;
    const double t50_h4_low = std::exp(2.0 * std::fmin(t50_h4_linear, 0.0));
    const double t50_h4_high = std::exp(-2.0 * std::fmax(t50_h4_linear, 0.0));
    const double t50_h4 = (t50_h4_low - t50_h4_high) / (t50_h4_low + t50_h4_high);
    const double t50_o1 = 0.11181658668112497 * t50_h1 + -0.029161656792099765 * t50_h2 +
                          -0.052400218818951017 * t50_h3 + 0.23810692888083676 * t50_h4 +
                          0.5557408827136996;
    const double t50_o2 = 0.37807121970604457 * t50_h1 + -0.019435566090726625 * t50_h2 +
                          -0.5763625385446824 * t50_h3 + -0.32986113875119666 * t50_h4 +
                          -4.507311657139688;
    const double t50_o3 = -0.8301720343211231 * t50_h1 + -0.07636910432360279 * t50_h2 +
                          -1.363406861738141 * t50_h3 + -1.2994914694057735 * t50_h4 +
                          -1.1655852403859512;
    const double t50_o4 = -0.19899555246497794 * t50_h1 + -0.1540609080602343 * t50_h2 +
                          0.051509407234928244 * t50_h3 + -0.1392701716342798 * t50_h4 +
                          0.41057488568249983;
    const double k50_h1_linear = -1.6614831161832437 * sand + 3.7406455326417882 * silt +
                                 -2.963801546801156 * clay + 5.847116192809454 * bulk_density +
                                 -9.611669323089613;
    const double k50_h1_low = std::exp(2.0 * std::fmin(k50_h1_linear, 0.0));
    const double k50_h1_high = std::exp(-2.0 * std::fmax(k50_h1_linear, 0.0));
    const double k50_h1 = (k50_h1_low - k50_h1_high) / (k50_h1_low + k50_h1_high);
    const double k50_h2_linear = -4.80218474970913 * sand + 10.356799242684076 * silt +
                                 -1.0181389129046838 * clay + 13.545615714848214 * bulk_density +
                                 -22.599451036527807;
    const double k50_h2_low = std::exp(2.0 * std::fmin(k50_h2_linear, 0.0));
    const double k50_h2_high = std::exp(-2.0 * std::fmax(k50_h2_linear, 0.0));
    const double k50_h2 = (k50_h2_low - k50_h2_high) / (k50_h2_low + k50_h2_high);
    const double k50_h3_linear = 7.933579188608622 * sand + 7.3757501143633055 * silt +
                                 -43.964624211973664 * clay + -18.985194431620428 * bulk_density +
                                 22.803547112602182;
    const double k50_h3_low = std::exp(2.0 * std::fmin(k50_h3_linear, 0.0));
    const double k50_h3_high = std::exp(-2.0 * std::fmax(k50_h3_linear, 0.0));
    const double k50_h3 = (k50_h3_low - k50_h3_high) / (k50_h3_low + k50_h3_high);
    const double k50_o1 = 1.3144122407995316 * k50_h1 + -0.9141892669569044 * k50_h2 +
                          0.6150568197585995 * k50_h3 + 1.4070372592225586;
    const double k50_o2 = 0.6885397822076358 * k50_h1 + 0.031688075070169366 * k50_h2 +
                          0.6120989713297392 * k50_h3 + 3.0532403659061442;
    const double theta_s =
        (t01_o1 + t02_o1 + t03_o1 + t04_o1 + t05_o1 + t06_o1 + t07_o1 + t08_o1 + t09_o1 + t10_o1 +
         t11_o1 + t12_o1 + t13_o1 + t14_o1 + t15_o1 + t16_o1 + t17_o1 + t18_o1 + t19_o1 + t20_o1 +
         t21_o1 + t22_o1 + t23_o1 + t24_o1 + t25_o1 + t26_o1 + t27_o1 + t28_o1 + t29_o1 + t30_o1 +
         t31_o1 + t32_o1 + t33_o1 + t34_o1 + t35_o1 + t36_o1 + t37_o1 + t38_o1 + t39_o1 + t40_o1 +
         t41_o1 + t42_o1 + t43_o1 + t44_o1 + t45_o1 + t46_o1 + t47_o1 + t48_o1 + t49_o1 + t50_o1) /
        50.0;
    const double mean_alpha_transformed =
        (t01_o2 + t02_o2 + t03_o2 + t04_o2 + t05_o2 + t06_o2 + t07_o2 + t08_o2 + t09_o2 + t10_o2 +
         t11_o2 + t12_o2 + t13_o2 + t14_o2 + t15_o2 + t16_o2 + t17_o2 + t18_o2 + t19_o2 + t20_o2 +
         t21_o2 + t22_o2 + t23_o2 + t24_o2 + t25_o2 + t26_o2 + t27_o2 + t28_o2 + t29_o2 + t30_o2 +
         t31_o2 + t32_o2 + t33_o2 + t34_o2 + t35_o2 + t36_o2 + t37_o2 + t38_o2 + t39_o2 + t40_o2 +
         t41_o2 + t42_o2 + t43_o2 + t44_o2 + t45_o2 + t46_o2 + t47_o2 + t48_o2 + t49_o2 + t50_o2) /
        50.0;
    const double alpha = std::exp(mean_alpha_transformed);
    const double mean_n_transformed =
        (t01_o3 + t02_o3 + t03_o3 + t04_o3 + t05_o3 + t06_o3 + t07_o3 + t08_o3 + t09_o3 + t10_o3 +
         t11_o3 + t12_o3 + t13_o3 + t14_o3 + t15_o3 + t16_o3 + t17_o3 + t18_o3 + t19_o3 + t20_o3 +
         t21_o3 + t22_o3 + t23_o3 + t24_o3 + t25_o3 + t26_o3 + t27_o3 + t28_o3 + t29_o3 + t30_o3 +
         t31_o3 + t32_o3 + t33_o3 + t34_o3 + t35_o3 + t36_o3 + t37_o3 + t38_o3 + t39_o3 + t40_o3 +
         t41_o3 + t42_o3 + t43_o3 + t44_o3 + t45_o3 + t46_o3 + t47_o3 + t48_o3 + t49_o3 + t50_o3) /
        50.0;
    const double n = std::exp(mean_n_transformed) + 1.0;
    const double m =
        (t01_o4 + t02_o4 + t03_o4 + t04_o4 + t05_o4 + t06_o4 + t07_o4 + t08_o4 + t09_o4 + t10_o4 +
         t11_o4 + t12_o4 + t13_o4 + t14_o4 + t15_o4 + t16_o4 + t17_o4 + t18_o4 + t19_o4 + t20_o4 +
         t21_o4 + t22_o4 + t23_o4 + t24_o4 + t25_o4 + t26_o4 + t27_o4 + t28_o4 + t29_o4 + t30_o4 +
         t31_o4 + t32_o4 + t33_o4 + t34_o4 + t35_o4 + t36_o4 + t37_o4 + t38_o4 + t39_o4 + t40_o4 +
         t41_o4 + t42_o4 + t43_o4 + t44_o4 + t45_o4 + t46_o4 + t47_o4 + t48_o4 + t49_o4 + t50_o4) /
        50.0;
    const double mean_k_sat_transformed =
        (k01_o1 + k02_o1 + k03_o1 + k04_o1 + k05_o1 + k06_o1 + k07_o1 + k08_o1 + k09_o1 + k10_o1 +
         k11_o1 + k12_o1 + k13_o1 + k14_o1 + k15_o1 + k16_o1 + k17_o1 + k18_o1 + k19_o1 + k20_o1 +
         k21_o1 + k22_o1 + k23_o1 + k24_o1 + k25_o1 + k26_o1 + k27_o1 + k28_o1 + k29_o1 + k30_o1 +
         k31_o1 + k32_o1 + k33_o1 + k34_o1 + k35_o1 + k36_o1 + k37_o1 + k38_o1 + k39_o1 + k40_o1 +
         k41_o1 + k42_o1 + k43_o1 + k44_o1 + k45_o1 + k46_o1 + k47_o1 + k48_o1 + k49_o1 + k50_o1) /
        50.0;
    const double k_sat = std::pow(10.0, mean_k_sat_transformed);
    const double tortuosity =
        (k01_o2 + k02_o2 + k03_o2 + k04_o2 + k05_o2 + k06_o2 + k07_o2 + k08_o2 + k09_o2 + k10_o2 +
         k11_o2 + k12_o2 + k13_o2 + k14_o2 + k15_o2 + k16_o2 + k17_o2 + k18_o2 + k19_o2 + k20_o2 +
         k21_o2 + k22_o2 + k23_o2 + k24_o2 + k25_o2 + k26_o2 + k27_o2 + k28_o2 + k29_o2 + k30_o2 +
         k31_o2 + k32_o2 + k33_o2 + k34_o2 + k35_o2 + k36_o2 + k37_o2 + k38_o2 + k39_o2 + k40_o2 +
         k41_o2 + k42_o2 + k43_o2 + k44_o2 + k45_o2 + k46_o2 + k47_o2 + k48_o2 + k49_o2 + k50_o2) /
        50.0;
    return Rudiyanto2021Parameters{theta_s, alpha, n, m, k_sat, tortuosity};
}

/**
 * @brief Estimate six FXW hydraulic parameters from texture fractions.
 * @param sand Sand mass fraction for particles from 50 to 2000 micrometers. (kg/kg)
 * @param silt Silt mass fraction for particles from 2 to 50 micrometers. (kg/kg)
 * @param clay Clay mass fraction for particles smaller than 2 micrometers. (kg/kg)
 * @return A result with the following fields:
 * - `theta_s` — Saturated volumetric water content of the FXW retention model. (cm³
 * cm⁻³)
 * - `alpha` — Inverse pressure-scale parameter in the FXW relative saturation function.
 * (cm⁻¹)
 * - `n` — FXW retention shape parameter n, fitted independently of m. (-)
 * - `m` — FXW retention shape parameter m, fitted independently of n. (-)
 * - `k_sat` — Saturated hydraulic conductivity of the FXW conductivity model. (cm d^-1)
 * - `tortuosity` — Pore tortuosity and connectivity parameter of the FXW conductivity model.
 * (-)
 *
 * @details Prediction target:
 * Six FXW retention and conductivity parameters from SSC predictors.
 * @note Texture inputs are mass fractions from 0 to 1 and must sum to one.
 * @note Return the ensemble mean in each network's output scale, then backtransform alpha, n
 * and saturated conductivity as in evaluate_nnet_grid.R. These are not arithmetic means of the
 * individually backtransformed hydraulic parameters.
 * @note The ensemble contains all 50 fitted realizations; uncertainty outputs are not
 * returned.
 * @warning The paper describes texture percentages; the supplied R program and its grid
 * instead use fractions. Do not pass percentages to this interface or rescale the supplied
 * weights.
 * @warning Training uses UNSODA drying data; no generalization beyond that data is
 * established.
 */
export [[nodiscard]]
inline Rudiyanto2021Parameters calc_ptf_rudiyanto2021_ssc(double sand, double silt, double clay) {
    const double t01_h1_linear = -2.932984315610752 * sand + 5.208208268784115 * silt +
                                 -0.05228869284336828 * clay + -1.8668640597044002;
    const double t01_h1_low = std::exp(2.0 * std::fmin(t01_h1_linear, 0.0));
    const double t01_h1_high = std::exp(-2.0 * std::fmax(t01_h1_linear, 0.0));
    const double t01_h1 = (t01_h1_low - t01_h1_high) / (t01_h1_low + t01_h1_high);
    const double t01_h2_linear = -7.2404959094083265 * sand + 28.809796447111225 * silt +
                                 -40.514627810565294 * clay + -1.1487816888837061;
    const double t01_h2_low = std::exp(2.0 * std::fmin(t01_h2_linear, 0.0));
    const double t01_h2_high = std::exp(-2.0 * std::fmax(t01_h2_linear, 0.0));
    const double t01_h2 = (t01_h2_low - t01_h2_high) / (t01_h2_low + t01_h2_high);
    const double t01_h3_linear = 6.932961696360279 * sand + -2.5690391370632906 * silt +
                                 -15.984248426200969 * clay + 1.5635953659679538;
    const double t01_h3_low = std::exp(2.0 * std::fmin(t01_h3_linear, 0.0));
    const double t01_h3_high = std::exp(-2.0 * std::fmax(t01_h3_linear, 0.0));
    const double t01_h3 = (t01_h3_low - t01_h3_high) / (t01_h3_low + t01_h3_high);
    const double t01_h4_linear = -0.1230511653133329 * sand + 2.241151939776911 * silt +
                                 4.557487166309222 * clay + -1.6761452585767094;
    const double t01_h4_low = std::exp(2.0 * std::fmin(t01_h4_linear, 0.0));
    const double t01_h4_high = std::exp(-2.0 * std::fmax(t01_h4_linear, 0.0));
    const double t01_h4 = (t01_h4_low - t01_h4_high) / (t01_h4_low + t01_h4_high);
    const double t01_h5_linear = 0.022759275076202873 * sand + -4.157114080775828 * silt +
                                 -0.8210623635538219 * clay + 1.075451739961013;
    const double t01_h5_low = std::exp(2.0 * std::fmin(t01_h5_linear, 0.0));
    const double t01_h5_high = std::exp(-2.0 * std::fmax(t01_h5_linear, 0.0));
    const double t01_h5 = (t01_h5_low - t01_h5_high) / (t01_h5_low + t01_h5_high);
    const double t01_o1 = -0.03910628313702079 * t01_h1 + -0.12251649852646176 * t01_h2 +
                          -0.07914832201838483 * t01_h3 + -0.21842865401424164 * t01_h4 +
                          -0.3680323285483762 * t01_h5 + 0.2733073107391847;
    const double t01_o2 = -1.2250927949563009 * t01_h1 + -0.06482519913781527 * t01_h2 +
                          0.2843748352640682 * t01_h3 + 1.8754331997265754 * t01_h4 +
                          0.11205751220662775 * t01_h5 + -3.5455450547583744;
    const double t01_o3 = -1.161470601269771 * t01_h1 + 0.4612597831780106 * t01_h2 +
                          1.5262463739287309 * t01_h3 + -0.3468210821720273 * t01_h4 +
                          2.4011252896534074 * t01_h5 + -2.790693886911479;
    const double t01_o4 = 0.23098951894827363 * t01_h1 + -0.09245013831940456 * t01_h2 +
                          -0.06667676464138962 * t01_h3 + -0.4458597364352385 * t01_h4 +
                          -0.061951040317833245 * t01_h5 + 0.4731816073070796;
    const double k01_h1_linear = -6.104540254734698 * sand + 16.950778002874813 * silt +
                                 -22.141320223912743 * clay + -0.221356920697116;
    const double k01_h1_low = std::exp(2.0 * std::fmin(k01_h1_linear, 0.0));
    const double k01_h1_high = std::exp(-2.0 * std::fmax(k01_h1_linear, 0.0));
    const double k01_h1 = (k01_h1_low - k01_h1_high) / (k01_h1_low + k01_h1_high);
    const double k01_h2_linear = 12.095083590162071 * sand + -3.2325904965336787 * silt +
                                 -20.100187128957476 * clay + 1.3938025212933247;
    const double k01_h2_low = std::exp(2.0 * std::fmin(k01_h2_linear, 0.0));
    const double k01_h2_high = std::exp(-2.0 * std::fmax(k01_h2_linear, 0.0));
    const double k01_h2 = (k01_h2_low - k01_h2_high) / (k01_h2_low + k01_h2_high);
    const double k01_h3_linear = 51.198490854361225 * sand + -55.9898650582368 * silt +
                                 -74.30721244635737 * clay + 17.9429485529309;
    const double k01_h3_low = std::exp(2.0 * std::fmin(k01_h3_linear, 0.0));
    const double k01_h3_high = std::exp(-2.0 * std::fmax(k01_h3_linear, 0.0));
    const double k01_h3 = (k01_h3_low - k01_h3_high) / (k01_h3_low + k01_h3_high);
    const double k01_h4_linear = -1.9594735524956333 * sand + 2.1344384873410123 * silt +
                                 -2.375022175394914 * clay + 0.3324645042454017;
    const double k01_h4_low = std::exp(2.0 * std::fmin(k01_h4_linear, 0.0));
    const double k01_h4_high = std::exp(-2.0 * std::fmax(k01_h4_linear, 0.0));
    const double k01_h4 = (k01_h4_low - k01_h4_high) / (k01_h4_low + k01_h4_high);
    const double k01_o1 = -1.1670169775966615 * k01_h1 + -0.9311368838025088 * k01_h2 +
                          -0.6399358980324464 * k01_h3 + 1.8824253417338226 * k01_h4 +
                          3.4027214311138083;
    const double k01_o2 = 0.09171121586728952 * k01_h1 + 0.6512991580705525 * k01_h2 +
                          -0.9231881069370408 * k01_h3 + -0.4626350405050831 * k01_h4 +
                          2.8976910185932043;
    const double t02_h1_linear = -2.046682103680029 * sand + 15.751445597989825 * silt +
                                 -19.596571541970302 * clay + 0.10774502861484692;
    const double t02_h1_low = std::exp(2.0 * std::fmin(t02_h1_linear, 0.0));
    const double t02_h1_high = std::exp(-2.0 * std::fmax(t02_h1_linear, 0.0));
    const double t02_h1 = (t02_h1_low - t02_h1_high) / (t02_h1_low + t02_h1_high);
    const double t02_h2_linear = 0.7877997097622931 * sand + -0.06488588073535778 * silt +
                                 0.9594581392646515 * clay + -1.2309690443987682;
    const double t02_h2_low = std::exp(2.0 * std::fmin(t02_h2_linear, 0.0));
    const double t02_h2_high = std::exp(-2.0 * std::fmax(t02_h2_linear, 0.0));
    const double t02_h2 = (t02_h2_low - t02_h2_high) / (t02_h2_low + t02_h2_high);
    const double t02_h3_linear = -3.525171614194717 * sand + 2.8811631020064277 * silt +
                                 1.9998500258756031 * clay + 1.1146117640157207;
    const double t02_h3_low = std::exp(2.0 * std::fmin(t02_h3_linear, 0.0));
    const double t02_h3_high = std::exp(-2.0 * std::fmax(t02_h3_linear, 0.0));
    const double t02_h3 = (t02_h3_low - t02_h3_high) / (t02_h3_low + t02_h3_high);
    const double t02_h4_linear = -0.41145269446941773 * sand + 10.082497556273573 * silt +
                                 -13.526421124925932 * clay + -0.205014902351079;
    const double t02_h4_low = std::exp(2.0 * std::fmin(t02_h4_linear, 0.0));
    const double t02_h4_high = std::exp(-2.0 * std::fmax(t02_h4_linear, 0.0));
    const double t02_h4 = (t02_h4_low - t02_h4_high) / (t02_h4_low + t02_h4_high);
    const double t02_h5_linear = 1.3887837604756816 * sand + -3.456608174919995 * silt +
                                 5.804503181049538 * clay + -0.3036142439407631;
    const double t02_h5_low = std::exp(2.0 * std::fmin(t02_h5_linear, 0.0));
    const double t02_h5_high = std::exp(-2.0 * std::fmax(t02_h5_linear, 0.0));
    const double t02_h5 = (t02_h5_low - t02_h5_high) / (t02_h5_low + t02_h5_high);
    const double t02_o1 = 0.31514830579977166 * t02_h1 + 0.03439679092225869 * t02_h2 +
                          0.03791913263425588 * t02_h3 + -0.3532728248854861 * t02_h4 +
                          0.015253236850712958 * t02_h5 + 0.4721263735870706;
