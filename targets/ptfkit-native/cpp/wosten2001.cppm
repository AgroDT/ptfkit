/**
 * @brief Evaluate water content and conductivity from Staring Series parameters.
 * @param theta_r Residual volumetric water content. (cm³/cm³)
 * @param theta_s Saturated volumetric water content. (cm³/cm³)
 * @param saturated_conductivity Saturated hydraulic conductivity. (cm/day)
 * @param alpha van Genuchten inverse pressure-head scale. (1/cm)
 * @param conductivity_shape_parameter Mualem hydraulic-conductivity shape parameter.
 * (dimensionless)
 * @param n van Genuchten pore-size distribution parameter. (dimensionless)
 * @param pressure_head_magnitude Nonnegative magnitude of pressure head; callers must convert
 * any signed-negative convention explicitly before calling. (cm)
 * @return A result with the following fields:
 * - `water_content` — Volumetric water content at the supplied pressure-head magnitude.
 * (cm³/cm³)
 * - `conductivity` — Hydraulic conductivity at the supplied pressure-head magnitude.
 * (cm/day)
 *
 * @details Prediction target:
 * Volumetric water content and unsaturated hydraulic conductivity at a nonnegative
 * pressure-head magnitude.
 * @note Pressure head is accepted as a nonnegative magnitude to make the sign convention
 * explicit.
 * @warning Parameters must belong to one internally consistent van Genuchten-Mualem parameter
 * set.
 */
export [[nodiscard]]
inline Wosten2001HydraulicResult
calc_ptf_wosten2001_hydraulic(double theta_r, double theta_s, double saturated_conductivity,
                              double alpha, double conductivity_shape_parameter, double n,
                              double pressure_head_magnitude) {
    const double m = 1.0 - 1.0 / n;
    const double pressure_term = std::pow(alpha * pressure_head_magnitude, n);
    const double effective_saturation = std::pow(1.0 + pressure_term, -m);
    const double water_content = theta_r + (theta_s - theta_r) * effective_saturation;
    const double conductivity =
        saturated_conductivity * std::pow(effective_saturation, conductivity_shape_parameter) *
        ((1.0 - std::pow(1.0 - std::pow(effective_saturation, 1.0 / m), m)) *
         (1.0 - std::pow(1.0 - std::pow(effective_saturation, 1.0 / m), m)));
    return Wosten2001HydraulicResult{water_content, conductivity};
}

/**
 * @brief Evaluate the printed Table 5 regressions for mineral sandy topsoils.
 * @param silt Mass percentage of particles smaller than 50 micrometers. (%)
 * @param organic_matter Soil organic-matter mass percentage. (%)
 * @param median_sand_size Median particle size of the sand fraction. (µm)
 * @return A result with the following fields:
 * - `bulk_density` — Dry bulk density predicted through the printed reciprocal-density
 * regression. (g/cm³)
 * - `theta_s` — Saturated volumetric water content predicted by the continuous regression.
 * (cm³/cm³)
 * - `saturated_conductivity` — Back-transformed saturated hydraulic conductivity. (cm/day)
 * - `alpha` — Back-transformed van Genuchten inverse pressure-head scale. (1/cm)
 * - `conductivity_shape_parameter` — Back-transformed Mualem hydraulic-conductivity shape
 * parameter. (dimensionless)
 * - `n` — Back-transformed van Genuchten pore-size distribution parameter. (dimensionless)
 *
 * @details Prediction target:
 * Bulk density, saturated water content, saturated conductivity, and the alpha, l, and n
 * parameters from the printed sandy-topsoil regressions.
 * @note This function fixes the source-defined BOVENGROND indicator to 1.
 * @note Positive inputs are required by the reciprocal and natural-log terms.
 * @warning The reciprocal-density expression must be positive before inversion.
 * @warning These are the printed rounded Table 5 equations; they do not claim numerical parity
 * with the unavailable Staringreeks 1.0 program.
 * @warning The report does not publish the legacy program's applicability-warning thresholds.
 */
export [[nodiscard]]
inline Wosten2001Table5Parameters calc_ptf_wosten2001_sand_topsoil_table5(double silt,
                                                                          double organic_matter,
                                                                          double median_sand_size) {
    const double topsoil_indicator = 1.0;
    const double silt_squared = silt * silt;
    const double organic_matter_squared = organic_matter * organic_matter;
    const double median_sand_size_squared = median_sand_size * median_sand_size;
    const double reciprocal_silt = 1.0 / silt;
    const double reciprocal_organic_matter = 1.0 / organic_matter;
    const double reciprocal_median_sand_size = 1.0 / median_sand_size;
    const double ln_silt = std::log(silt);
    const double ln_organic_matter = std::log(organic_matter);
    const double ln_median_sand_size = std::log(median_sand_size);
    const double reciprocal_density =
        -7.58 + 0.01791 * organic_matter + 0.0326 * topsoil_indicator - 0.00338 * median_sand_size +
        0.00003937 * silt_squared + 157.7 * reciprocal_median_sand_size +
        1.522 * ln_median_sand_size;
    const double bulk_density = 1.0 / reciprocal_density;
    const double bulk_density_squared = bulk_density * bulk_density;
    const double theta_s = -35.7 - 0.1843 * bulk_density - 0.03576 * median_sand_size +
                           0.0000261 * median_sand_size_squared - 0.0564 * reciprocal_silt +
                           0.008 * reciprocal_organic_matter + 496.0 * reciprocal_median_sand_size +
                           0.02244 * ln_organic_matter + 7.56 * ln_median_sand_size;
    const double log_saturated_conductivity = 45.8 - 14.34 * bulk_density +
                                              0.001481 * silt_squared - 27.5 * reciprocal_density -
                                              0.891 * ln_silt - 0.34 * ln_organic_matter;
    const double saturated_conductivity = std::exp(log_saturated_conductivity);
    const double log_alpha = 13.66 - 5.91 * bulk_density - 0.172 * topsoil_indicator +
                             0.003248 * median_sand_size - 11.89 * reciprocal_density -
                             2.121 * reciprocal_silt - 0.3742 * ln_silt;
    const double alpha = std::exp(log_alpha);
    const double transformed_l = -76.4 - 0.097 * silt + 59.6 * bulk_density +
                                 0.0332 * median_sand_size - 13.45 * bulk_density_squared +
                                 0.001127 * silt_squared + 0.00431 * organic_matter_squared -
                                 0.0000399 * median_sand_size_squared + 40.8 * reciprocal_density +
                                 2.364 * reciprocal_silt + 1.014 * ln_silt;
    const double exp_transformed_l = std::exp(transformed_l);
    const double conductivity_shape_parameter =
        2.0 * (exp_transformed_l - 1.0) / (exp_transformed_l + 1.0);
    const double log_n_minus_one = -1.057 + 0.1003 * organic_matter + 1.119 * bulk_density +
                                   0.000764 * silt_squared - 0.1397 * reciprocal_organic_matter -
                                   57.2 * reciprocal_median_sand_size - 0.557 * ln_organic_matter -
                                   0.02997 * bulk_density * silt;
    const double n = 1.0 + std::exp(log_n_minus_one);
    return Wosten2001Table5Parameters{
        bulk_density, theta_s, saturated_conductivity, alpha, conductivity_shape_parameter, n};
}

