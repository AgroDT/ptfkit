 * @warning The report does not publish the legacy program's applicability-warning thresholds.
 */
export [[nodiscard]]
inline Wosten2001Table5Parameters calc_ptf_wosten2001_loam_clay_table5(double clay,
                                                                       double organic_matter) {
    const double organic_matter_squared = organic_matter * organic_matter;
    const double reciprocal_organic_matter = 1.0 / organic_matter;
    const double ln_clay = std::log(clay);
    const double ln_organic_matter = std::log(organic_matter);
    const double reciprocal_density =
        0.6117 + 0.003601 * clay + 0.002172 * organic_matter_squared + 0.01715 * ln_organic_matter;
    const double bulk_density = 1.0 / reciprocal_density;
    const double bulk_density_squared = bulk_density * bulk_density;
    const double density_organic_matter = bulk_density * organic_matter;
    const double density_clay = bulk_density * clay;
    const double clay_organic_matter = clay * organic_matter;
    const double theta_s =
        0.6311 + 0.003383 * clay - 0.09699 * bulk_density_squared - 0.00204 * density_clay;
    const double log_saturated_conductivity =
        -42.6 + 8.71 * organic_matter + 61.9 * bulk_density - 20.79 * bulk_density_squared -
        0.2107 * organic_matter_squared - 0.01622 * clay_organic_matter -
        5.382 * density_organic_matter;
    const double saturated_conductivity = std::exp(log_saturated_conductivity);
    const double log_alpha = -19.13 + 0.812 * organic_matter + 23.4 * bulk_density -
                             8.16 * bulk_density_squared + 0.423 * reciprocal_organic_matter +
                             2.388 * ln_organic_matter - 1.338 * density_organic_matter;
    const double alpha = std::exp(log_alpha);
    const double transformed_l = 0.102 + 0.0222 * clay - 0.043 * density_clay;
    const double exp_transformed_l = std::exp(transformed_l);
    const double conductivity_shape_parameter =
        10.0 * (exp_transformed_l - 1.0) / (exp_transformed_l + 1.0);
    const double log_n_minus_one = -0.235 + 0.972 * reciprocal_density - 0.7743 * ln_clay -
                                   0.3154 * ln_organic_matter + 0.0678 * density_organic_matter;
    const double n = 1.0 + std::exp(log_n_minus_one);
    return Wosten2001Table5Parameters{
        bulk_density, theta_s, saturated_conductivity, alpha, conductivity_shape_parameter, n};
}

} // namespace ptfkit::wosten2001
