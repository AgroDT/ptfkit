[[nodiscard]]
inline double calc_ptf_tiwary2014_igp(double sand, double bulk_density, double esp) {
    const double k_sat_mm_per_hour = 4.079 + 0.047 * sand - 0.054 * esp - 2.238 * bulk_density;
