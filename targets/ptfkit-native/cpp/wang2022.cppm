    const double inputs[] = {sand, silt, clay, bulk_density};
    double sum = 0.0;
    for (unsigned tree = 0; tree < sizeof(roots) / sizeof(roots[0]); ++tree) {
        unsigned node = roots[tree];
        while (features[node] >= 0) {
            node = inputs[(unsigned)features[node]] <= thresholds[node] ? children_left[node]
                                                                        : children_right[node];
        }
        sum += values[node];
    }
    return sum / (double)(sizeof(roots) / sizeof(roots[0]));
}

/**
 * @brief Estimate six soil hydraulic-model parameters from sand, silt, and clay with the
 * published H2 random forests.
 * @param sand Sand content by mass. (%)
 * @param silt Silt content by mass. (%)
 * @param clay Clay content by mass. (%)
 * @return A result with the following fields:
 * - `alpha` — van Genuchten inverse pressure-scale parameter. (cm⁻¹)
 * - `n` — van Genuchten pore-size distribution parameter. (dimensionless)
 * - `m` — van Genuchten retention-curve shape parameter. (dimensionless)
 * - `theta_s` — Saturated volumetric soil water content. (cm³ cm⁻³)
 * - `k_sat` — Saturated hydraulic conductivity. (cm day⁻¹)
 * - `sl` — Source-defined soil hydraulic slope parameter. (dimensionless)
 *
 * @details Prediction target:
 * van Genuchten alpha, n, and m, saturated volumetric water content, saturated hydraulic
 * conductivity, and the source-defined slope parameter SL.
 * @note The proposed public contract accepts texture in percent and divides each value by 100
 * before passing predictors to the serialized models.
 * @note The serialized models predict log10(alpha), log10(n), log10(m), and log10(Ks);
 * official code applies 10 raised to each prediction. Theta_s and SL are emitted directly.
 * @note Predictor order is sand, silt, clay and must be preserved exactly.
 * @warning The supplied source describes texture as article percentages but the executable
 * workbook and code use fractions summing to one. This API makes that boundary explicit by
 * accepting percent and dividing by 100.
 */
export [[nodiscard]]
inline Wang2022PTFResult calc_ptf_wang2022_h2(double sand, double silt, double clay) {
    const double sand_fraction = sand / 100.0;
    const double silt_fraction = silt / 100.0;
    const double clay_fraction = clay / 100.0;
    const double alpha_log10 =
        wang2022_wang2022_alpha_h2(sand_fraction, silt_fraction, clay_fraction);
    const double alpha = std::pow(10.0, alpha_log10);
    const double n_log10 = wang2022_wang2022_n_h2(sand_fraction, silt_fraction, clay_fraction);
    const double n = std::pow(10.0, n_log10);
    const double m_log10 = wang2022_wang2022_m_h2(sand_fraction, silt_fraction, clay_fraction);
    const double m = std::pow(10.0, m_log10);
    const double theta_s =
        wang2022_wang2022_theta_s_h2(sand_fraction, silt_fraction, clay_fraction);
    const double k_sat_log10 =
        wang2022_wang2022_k_sat_h2(sand_fraction, silt_fraction, clay_fraction);
    const double k_sat = std::pow(10.0, k_sat_log10);
    const double sl = wang2022_wang2022_sl_h2(sand_fraction, silt_fraction, clay_fraction);
    return Wang2022PTFResult{alpha, n, m, theta_s, k_sat, sl};
}

/**
 * @brief Estimate six soil hydraulic-model parameters from texture and bulk density with the
 * published H3 random forests.
 * @param sand Sand content by mass. (%)
 * @param silt Silt content by mass. (%)
 * @param clay Clay content by mass. (%)
 * @param bulk_density Dry bulk density used by the H3 random-forest models. (g/cm^3)
 * @return A result with the following fields:
 * - `alpha` — van Genuchten inverse pressure-scale parameter. (cm⁻¹)
 * - `n` — van Genuchten pore-size distribution parameter. (dimensionless)
 * - `m` — van Genuchten retention-curve shape parameter. (dimensionless)
 * - `theta_s` — Saturated volumetric soil water content. (cm³ cm⁻³)
 * - `k_sat` — Saturated hydraulic conductivity. (cm day⁻¹)
 * - `sl` — Source-defined soil hydraulic slope parameter. (dimensionless)
 *
 * @details Prediction target:
 * van Genuchten alpha, n, and m, saturated volumetric water content, saturated hydraulic
 * conductivity, and the source-defined slope parameter SL.
 * @note The serialized models predict log10(alpha), log10(n), log10(m), and log10(Ks);
 * official code applies 10 raised to each prediction. Theta_s and SL are emitted directly.
 * @note Predictor order is sand, silt, clay, bulk density and must be preserved exactly.
 * @warning The supplied source describes texture as article percentages but the executable
 * workbook and code use fractions summing to one. This API makes that boundary explicit by
 * accepting percent and dividing by 100.
 */
export [[nodiscard]]
inline Wang2022PTFResult calc_ptf_wang2022_h3(double sand, double silt, double clay,
                                              double bulk_density) {
    const double sand_fraction = sand / 100.0;
    const double silt_fraction = silt / 100.0;
    const double clay_fraction = clay / 100.0;
    const double alpha_log10 =
        wang2022_wang2022_alpha_h3(sand_fraction, silt_fraction, clay_fraction, bulk_density);
    const double alpha = std::pow(10.0, alpha_log10);
    const double n_log10 =
        wang2022_wang2022_n_h3(sand_fraction, silt_fraction, clay_fraction, bulk_density);
    const double n = std::pow(10.0, n_log10);
    const double m_log10 =
        wang2022_wang2022_m_h3(sand_fraction, silt_fraction, clay_fraction, bulk_density);
    const double m = std::pow(10.0, m_log10);
    const double theta_s =
        wang2022_wang2022_theta_s_h3(sand_fraction, silt_fraction, clay_fraction, bulk_density);
    const double k_sat_log10 =
        wang2022_wang2022_k_sat_h3(sand_fraction, silt_fraction, clay_fraction, bulk_density);
    const double k_sat = std::pow(10.0, k_sat_log10);
    const double sl =
        wang2022_wang2022_sl_h3(sand_fraction, silt_fraction, clay_fraction, bulk_density);
    return Wang2022PTFResult{alpha, n, m, theta_s, k_sat, sl};
}

