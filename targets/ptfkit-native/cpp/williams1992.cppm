/**
 * @brief Predict volumetric water content with Williams et al. Function 1.
 * @param clay Clay below 0.002 mm, as a mass percentage. (%)
 * @param fine_sand Fine sand from 0.02 to 0.20 mm, as a mass percentage. (%)
 * @param coarse_sand Coarse sand from 0.20 to 2.0 mm, as a mass percentage. (%)
 * @param organic_matter Organic-matter mass percentage. (%)
 * @param water_potential Water-potential magnitude. (bar)
 * @return Predicted volumetric water content at the supplied water-potential magnitude. (%)
 *
 * @details Prediction target:
 * Volumetric water content at a specified water-potential magnitude.
 * @note Natural logarithms are used.
 * @warning The source does not publish exact multivariate calibration boundaries.
 */
export [[nodiscard]]
inline double calc_ptf_williams1992_function_1(double clay, double fine_sand, double coarse_sand,
                                               double organic_matter, double water_potential) {
    const double fine_sand_squared = fine_sand * fine_sand;
    const double ln_clay = std::log(clay);
    const double coefficient_a = 2.57 + 0.238 * ln_clay - 0.000192 * fine_sand_squared -
                                 0.0137 * coarse_sand + 0.112 * std::log(coarse_sand) -
                                 0.0926 * std::log(organic_matter) + 0.0412 * organic_matter;
    const double coefficient_b =
        -0.403 + 0.0871 * ln_clay + 0.0014 * coarse_sand - 0.00077 * fine_sand;
    return std::exp(coefficient_a + coefficient_b * std::log(water_potential));
}

