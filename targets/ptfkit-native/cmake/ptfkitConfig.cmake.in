@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/ptfkitTargets.cmake")
set(ptfkit_c_FOUND TRUE)
set(_ptfkit_model_source "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/ptfkit/rosetta3_data.c")
if(EXISTS "${_ptfkit_model_source}" AND NOT TARGET ptfkit_model_data)
    add_library(ptfkit_model_data STATIC "${_ptfkit_model_source}")
    if(NOT CMAKE_C_COMPILER_LOADED)
        set_source_files_properties("${_ptfkit_model_source}" PROPERTIES LANGUAGE CXX)
    endif()
    set_target_properties(ptfkit_model_data PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_link_libraries(ptfkit::c INTERFACE ptfkit_model_data)
endif()
unset(_ptfkit_model_source)
get_target_property(_ptfkit_c_libraries ptfkit::c INTERFACE_LINK_LIBRARIES)
if(UNIX AND NOT "m" IN_LIST _ptfkit_c_libraries)
    set_property(TARGET ptfkit::c APPEND PROPERTY INTERFACE_LINK_LIBRARIES m)
endif()
unset(_ptfkit_c_libraries)

if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.28)
    include("${CMAKE_CURRENT_LIST_DIR}/ptfkitCppModules.cmake" OPTIONAL)
endif()
if(TARGET ptfkit::cpp)
    set(ptfkit_cpp_FOUND TRUE)
endif()

check_required_components(ptfkit)
