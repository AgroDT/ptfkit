{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ptfkit-eval reproducible retention run",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evaluation_plan", "dataset", "protocol", "bootstrap"],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_plan": {"$ref": "#/$defs/file"},
    "dataset": {"$ref": "#/$defs/file"},
    "protocol": {"$ref": "#/$defs/protocol"},
    "bootstrap": {"$ref": "#/$defs/bootstrap"},
    "selection": {"$ref": "#/$defs/selection"},
    "approximations": {"type": "array", "items": {"$ref": "#/$defs/approximation"}},
    "prediction_intervals": {"type": "array", "items": {"$ref": "#/$defs/predictionIntervals"}}
  },
  "$defs": {
    "predictionIntervals": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "candidate_id", "training_groups", "calibration_groups", "test_groups", "pressure_grid_kpa", "confidence_level", "minimum_calibration_groups", "grouping"],
      "properties": {
        "method": {"const": "fixed_group_max_split_conformal_v1"},
        "candidate_id": {"$ref": "#/$defs/text"},
        "grouping": {"enum": ["source", "profile"]},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "minimum_calibration_groups": {"type": "integer", "minimum": 2},
        "pressure_grid_kpa": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "minimum": 0}},
        "training_groups": {"$ref": "#/$defs/groupIds"}, "calibration_groups": {"$ref": "#/$defs/groupIds"}, "test_groups": {"$ref": "#/$defs/groupIds"}
      }
    },
    "groupIds": {"type": "array", "uniqueItems": true, "items": {
      "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}
    }},
    "approximation": {
      "type": "object", "additionalProperties": false,
      "required": ["family_id", "parameters", "seed", "minimum_log10_span", "n_starts", "max_evaluations", "optimizer_tolerance", "boundary_tolerance", "rank_tolerance", "maximum_condition_number", "objective_agreement_tolerance", "parameter_agreement_tolerance", "confidence_level", "method", "uncertainty_method"],
      "properties": {
        "family_id": {"enum": ["van_genuchten_mualem_v1", "van_genuchten_m1_v1", "brooks_corey_v1", "clapp1978_gradual_air_entry_v1"]},
        "parameters": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "lower", "upper", "initial"],
          "properties": {"name": {"$ref": "#/$defs/text"}, "lower": {"type": "number"}, "upper": {"type": "number"}, "initial": {"type": "number"}}
        }},
        "seed": {"type": "integer", "minimum": 0},
        "minimum_log10_span": {"type": "number", "exclusiveMinimum": 0},
        "n_starts": {"type": "integer", "minimum": 1}, "max_evaluations": {"type": "integer", "minimum": 1},
        "optimizer_tolerance": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "boundary_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "rank_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "maximum_condition_number": {"type": "number", "minimum": 1},
        "objective_agreement_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "parameter_agreement_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "method": {"const": "bounded_trf_uniform_multistart_v1"},
        "uncertainty_method": {"const": "local_linear_iid_student_t_v1"}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "candidate_ids", "folds", "loss", "minimum_coverage", "tie_breaker", "failure_policy"],
      "properties": {
        "method": {"const": "fixed_candidate_nested_selection_v1"},
        "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "minimum_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "tie_breaker": {"const": "candidate_id"},
        "failure_policy": {"const": "require_common_cohort"},
        "folds": {
          "type": "object", "additionalProperties": false,
          "required": ["seed", "outer_folds", "inner_folds", "grouping", "missing_profiles", "minimum_training_groups", "minimum_validation_groups"],
          "properties": {
            "seed": {"type": "integer"},
            "outer_folds": {"type": "integer", "minimum": 2}, "inner_folds": {"type": "integer", "minimum": 2},
            "grouping": {"enum": ["source", "profile"]}, "missing_profiles": {"enum": ["reject", "source"]},
            "minimum_training_groups": {"type": "integer", "minimum": 1},
            "minimum_validation_groups": {"type": "integer", "minimum": 1}
          }
        },
        "loss": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "lower_suction_kpa", "upper_suction_kpa", "minimum_points"],
          "properties": {"method": {"const": "log10_trapezoid_mse_v1"},
                         "lower_suction_kpa": {"type": "number", "exclusiveMinimum": 0},
                         "upper_suction_kpa": {"type": "number", "exclusiveMinimum": 0},
                         "minimum_points": {"type": "integer", "minimum": 2}}
        }
      }
    },
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "observation_method", "allowed_target_origins", "cohorts", "bindings"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "observation_method": {"$ref": "#/$defs/text"},
        "allowed_target_origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["measured", "derived", "synthetic"]}},
        "cohorts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["maximal", "common"]}},
        "bindings": {
          "type": "object", "additionalProperties": {
            "type": "object", "additionalProperties": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "bootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "seed", "minimum_groups", "grouping", "missing_profiles", "confidence_level", "n_resamples"],
      "properties": {
        "method": {"const": "cluster_percentile_linear_v1"},
        "seed": {"type": "integer"}, "minimum_groups": {"type": "integer", "minimum": 2},
        "grouping": {"enum": ["source", "profile"]}, "missing_profiles": {"enum": ["reject", "source"]},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "n_resamples": {"type": "integer", "minimum": 2}
      }
    }
  }
}
