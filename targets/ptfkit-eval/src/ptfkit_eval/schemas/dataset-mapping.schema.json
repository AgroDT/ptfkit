{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptfkit.org/schemas/dataset-mapping.schema.json",
  "title": "ptfkit-eval dataset mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "source",
    "identity",
    "worksheets",
    "encodings",
    "formula_policy",
    "reviewed_corrections",
    "quarantines",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset": {"$ref": "#/$defs/dataset"},
    "source": {"$ref": "#/$defs/source"},
    "identity": {"$ref": "#/$defs/identity"},
    "worksheets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/worksheet"}
    },
    "encodings": {
      "type": "array",
      "items": {"$ref": "#/$defs/encoding"}
    },
    "formula_policy": {"$ref": "#/$defs/formulaPolicy"},
    "reviewed_corrections": {
      "type": "array",
      "items": {"$ref": "#/$defs/correction"}
    },
    "quarantines": {
      "type": "array",
      "items": {"$ref": "#/$defs/quarantine"}
    },
    "blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/blocker"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "status": {
      "enum": ["confirmed", "proposed", "blocked", "context_only", "derived"]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft_blocked", "review_ready", "active"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size_bytes", "inventory", "retention_profile"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "inventory": {"type": "string", "minLength": 1},
        "retention_profile": {"type": "string", "minLength": 1},
        "redistribution_status": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "join_policy", "source_aliases", "sample_crosswalks"],
      "properties": {
        "sample_id": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "components", "separator"],
          "properties": {
            "kind": {"const": "composite"},
            "components": {
              "type": "array",
              "prefixItems": [{"const": "source"}, {"const": "sample_number"}],
              "items": false
            },
            "separator": {"const": "_"},
            "formula": {"type": "string", "minLength": 1}
          }
        },
        "join_policy": {"enum": ["exact_after_reviewed_aliases", "exact_only"]},
        "source_aliases": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceAlias"}
        },
        "sample_crosswalks": {
          "type": "array",
          "items": {"$ref": "#/$defs/sampleCrosswalk"}
        }
      }
    },
    "sourceAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worksheet", "raw", "canonical", "status", "evidence"],
      "properties": {
        "worksheet": {"type": "string", "minLength": 1},
        "raw": {"type": "string", "minLength": 1},
        "canonical": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "confirmed"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "sampleCrosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worksheet", "raw_sample_id", "canonical_sample_id", "status", "evidence"],
      "properties": {
        "worksheet": {"type": "string", "minLength": 1},
        "raw_sample_id": {"type": "string", "minLength": 1},
        "canonical_sample_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "confirmed"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "worksheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "dimension",
        "kind",
        "status",
        "header_rows",
        "data_rows",
        "row_roles",
        "columns"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*:[A-Z]+[1-9][0-9]*$"},
        "kind": {"$ref": "#/$defs/identifier"},
        "status": {"$ref": "#/$defs/status"},
        "header_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "data_rows": {"$ref": "#/$defs/rowRange"},
        "row_roles": {
          "type": "array",
          "items": {"$ref": "#/$defs/rowRole"}
        },
        "columns": {
          "type": "array",
          "items": {"$ref": "#/$defs/column"}
        },
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "rowRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": {"type": "integer", "minimum": 1},
        "last": {"type": "integer", "minimum": 1}
      }
    },
    "rowRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "when"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "status": {"$ref": "#/$defs/status"},
        "when": {
          "oneOf": [
            {"const": "otherwise"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "operator", "value"],
              "properties": {
                "column": {"type": "string", "pattern": "^[A-Z]+$"},
                "operator": {"enum": ["equals", "not_equals"]},
                "value": {}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["column", "operator", "values"],
              "properties": {
                "column": {"type": "string", "pattern": "^[A-Z]+$"},
                "operator": {"enum": ["in", "not_in"]},
                "values": {"type": "array", "minItems": 1}
              }
            }
          ]
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "role", "status"],
      "properties": {
        "column": {"type": "string", "pattern": "^[A-Z]+$"},
        "source_header": {"type": ["string", "null"]},
        "role": {"$ref": "#/$defs/identifier"},
        "status": {"$ref": "#/$defs/status"},
        "measurement": {"$ref": "#/$defs/measurement"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "unit"],
      "properties": {
        "quantity": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]},
        "material_basis": {"type": ["string", "null"]},
        "denominator_basis": {"type": ["string", "null"]},
        "particle_size": {"$ref": "#/$defs/particleSize"}
      }
    },
    "particleSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "lower", "upper", "lower_inclusive", "upper_inclusive"],
      "properties": {
        "unit": {"const": "micrometer"},
        "lower": {"type": ["number", "null"], "minimum": 0},
        "upper": {"type": ["number", "null"], "minimum": 0},
        "lower_inclusive": {"type": "boolean"},
        "upper_inclusive": {"type": "boolean"}
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "worksheet", "selector", "status", "interpretation"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "worksheet": {"type": "string", "minLength": 1},
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column", "value"],
          "properties": {
            "column": {"type": "string", "pattern": "^[A-Z]+$"},
            "value": {}
          }
        },
        "status": {"$ref": "#/$defs/status"},
        "interpretation": {"type": "string", "minLength": 1},
        "measurement": {"$ref": "#/$defs/measurement"},
        "conversion": {"type": "string", "minLength": 1},
        "blockers": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "formulaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_formulas", "read_cached_values", "recalculate", "derived_columns"],
      "properties": {
        "read_formulas": {"const": true},
        "read_cached_values": {"const": true},
        "recalculate": {"const": false},
        "derived_columns": {
          "type": "array",
          "items": {"$ref": "#/$defs/derivedColumn"}
        }
      }
    },
    "derivedColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worksheet", "column", "purpose", "validation"],
      "properties": {
        "worksheet": {"type": "string", "minLength": 1},
        "column": {"type": "string", "pattern": "^[A-Z]+$"},
        "purpose": {"type": "string", "minLength": 1},
        "validation": {"type": "string", "minLength": 1}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cells", "replacement", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "cells": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "replacement": {},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "reason", "release_requires"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "scope": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "release_requires": {"type": "string", "minLength": 1}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "question", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "scope": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
