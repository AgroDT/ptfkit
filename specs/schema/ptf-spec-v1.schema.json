{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgroDT/ptfkit/blob/main/specs/schema/ptf-spec-v1.schema.json",
  "title": "PTF source specification front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "functions"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "$ref": "#/$defs/source" },
    "scope": { "$ref": "#/$defs/commonScope" },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/function" }
    }
  },
  "$defs": {
    "stringOrNull": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "citation_apa", "doi"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "title": { "type": "string", "minLength": 1 },
        "citation_apa": { "type": "string", "minLength": 1 },
        "doi": { "type": ["string", "null"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commonScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "dataset": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "functionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_target", "models"],
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "dataset": { "$ref": "#/$defs/stringOrNull" },
        "prediction_target": { "type": "string", "minLength": 1 },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["h_theta", "k_h"],
          "properties": {
            "h_theta": { "$ref": "#/$defs/stringOrNull" },
            "k_h": { "$ref": "#/$defs/stringOrNull" }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "unit", "domain", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "$ref": "#/$defs/stringOrNull" },
        "unit": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/stringOrNull" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "goldenTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected", "rtol", "atol", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object", "minProperties": 1 },
        "expected": { "type": "object", "minProperties": 1 },
        "rtol": { "type": "number", "minimum": 0 },
        "atol": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "edgeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected_behavior", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object", "minProperties": 1 },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "public_api",
        "scope",
        "inputs",
        "outputs"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^calc_ptf_[a-z][a-z0-9_]*$" },
        "status": {
          "enum": [
            "draft",
            "blocked",
            "ready-for-implementation",
            "implemented"
          ]
        },
        "public_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "name", "result_class", "summary"],
          "properties": {
            "module": {
              "type": "string",
              "pattern": "^ptfkit\\.[a-z][a-z0-9_]*$"
            },
            "name": {
              "type": "string",
              "pattern": "^calc_ptf_[a-z][a-z0-9_]*$"
            },
            "result_class": { "$ref": "#/$defs/stringOrNull" },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "scope": { "$ref": "#/$defs/functionScope" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "golden_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/goldenTest" }
        },
        "edge_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgeCase" }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
