{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgroDT/ptfkit/blob/main/specs/schema/ptf-spec.schema.json",
  "title": "PTF source specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "functions"],
  "properties": {
    "source": { "$ref": "#/$defs/source" },
    "scope": { "$ref": "#/$defs/commonScope" },
    "generation": { "$ref": "#/$defs/generation" },
    "$defs": { "$ref": "#/$defs/sourceDefinitions" },
    "scientific_notes": { "type": "string" },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/function" }
    }
  },
  "$defs": {
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_python": {
          "enum": ["generated", "manual"],
          "default": "generated"
        }
      }
    },
    "implementationVariable": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "expr"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "expr": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "lookup"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "lookup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["table", "key"],
              "properties": {
                "table": { "$ref": "#/$defs/localReference" },
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "tree"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "tree": {
              "type": "object",
              "additionalProperties": false,
              "required": ["definition", "arguments"],
              "properties": {
                "definition": { "$ref": "#/$defs/localReference" },
                "arguments": {
                  "type": "object",
                  "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "decision_tree"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "decision_tree": { "$ref": "#/$defs/decisionTree" }
          }
        }
      ]
    },
    "decisionTree": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["leaf"],
          "properties": {
            "leaf": {
              "oneOf": [
                { "type": "number" },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "number" }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["split", "yes", "no"],
          "properties": {
            "split": { "$ref": "#/$defs/decisionTreeSplit" },
            "yes": { "$ref": "#/$defs/decisionTree" },
            "no": { "$ref": "#/$defs/decisionTree" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["match"],
          "properties": {
            "match": {
              "type": "object",
              "additionalProperties": false,
              "required": ["input", "cases"],
              "properties": {
                "input": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "cases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["values", "then"],
                    "properties": {
                      "values": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
                      },
                      "then": { "$ref": "#/$defs/decisionTree" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "decisionTreeSplit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "operator", "value"],
          "properties": {
            "input": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "operator": { "const": "lt" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "operator", "values"],
          "properties": {
            "input": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "operator": { "const": "in" },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            }
          }
        }
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variables"],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/implementationVariable" }
        }
      }
    },
    "lookupDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output", "values"],
      "properties": {
        "type": { "const": "lookup" },
        "input": { "$ref": "#/$defs/localReference" },
        "output": { "$ref": "#/$defs/localReference" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lookupValue" }
        }
      }
    },
    "lookupValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "treeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "inputs", "output", "root"],
      "properties": {
        "type": { "const": "tree" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/treeInput" }
        },
        "output": { "$ref": "#/$defs/localReference" },
        "root": { "$ref": "#/$defs/decisionTree" }
      }
    },
    "treeInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "type": { "const": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "$ref"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "$ref": {
              "type": "string",
              "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9_]*$"
            }
          }
        }
      ]
    },
    "stringOrNull": { "type": ["string", "null"] },
    "localReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^(#/\\$defs/[A-Za-z][A-Za-z0-9_]*|[A-Za-z0-9._/-]+#/\\$defs/[A-Za-z][A-Za-z0-9_]*)$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "citation_apa", "doi"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 100 },
        "citation_apa": { "type": "string", "minLength": 1 },
        "doi": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "url"],
              "properties": {
                "identifier": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "commonScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "dataset": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "functionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_target", "models"],
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "prediction_target": { "type": "string", "minLength": 1 },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["h_theta", "k_h"],
          "properties": {
            "h_theta": { "$ref": "#/$defs/stringOrNull" },
            "k_h": { "$ref": "#/$defs/stringOrNull" }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "unit", "domain", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "$ref": "#/$defs/stringOrNull" },
        "unit": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/stringOrNull" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "outputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity", "symbol", "unit", "reported_unit", "domain", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "reported_unit": { "type": "string", "minLength": 1 },
        "symbol": { "$ref": "#/$defs/stringOrNull" },
        "unit": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "domain": { "$ref": "#/$defs/stringOrNull" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "verificationToleranceOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "source_location"],
      "properties": {
        "absolute": { "type": "number", "exclusiveMinimum": 0 },
        "relative": { "type": "number", "minimum": 0 },
        "source_location": { "type": "string", "minLength": 1 }
      }
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "$ref"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "$ref": {
          "type": "string",
          "pattern": "^(#/\\$defs/[A-Za-z][A-Za-z0-9_]*|[A-Za-z0-9._/-]+#/\\$defs/[A-Za-z][A-Za-z0-9_]*)$"
        }
      }
    },
    "enumDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description", "values"],
      "properties": {
        "type": { "const": "enum" },
        "description": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/enumValue" }
        }
      }
    },
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "sourceDefinitions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/enumDefinition" },
          { "$ref": "#/$defs/lookupDefinition" },
          { "$ref": "#/$defs/treeDefinition" },
          { "$ref": "#/$defs/outputs" },
          { "$ref": "#/$defs/parameter" }
        ]
      }
    },
    "outputs": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "quantity",
            "symbol",
            "unit",
            "reported_unit",
            "domain",
            "description"
          ],
          "properties": {
            "type": { "const": "scalar" },
            "name": { "type": "string", "minLength": 1 },
            "quantity": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "reported_unit": { "type": "string", "minLength": 1 },
            "symbol": { "$ref": "#/$defs/stringOrNull" },
            "unit": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "domain": { "$ref": "#/$defs/stringOrNull" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "fields"],
          "properties": {
            "type": { "const": "record" },
            "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/outputField" }
            }
          }
        }
      ]
    },
    "verificationCase": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "inputs", "expected", "source_location"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "published" },
            "inputs": { "type": "object", "minProperties": 1 },
            "expected": { "type": "object", "minProperties": 1 },
            "source_location": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "inputs", "expected", "rationale"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "calculated" },
            "inputs": { "type": "object", "minProperties": 1 },
            "expected": { "type": "object", "minProperties": 1 },
            "source_location": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      ]
    },
    "edgeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected_behavior", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object", "minProperties": 1 },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "public_api",
        "scope",
        "inputs",
        "outputs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["ready-for-implementation", "implemented"] }
            }
          },
          "then": {
            "required": ["implementation", "verification_cases"],
            "properties": {
              "verification_cases": { "minItems": 1 }
            }
          }
        }
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^calc_ptf_[a-z][a-z0-9_]*$" },
        "status": {
          "enum": [
            "draft",
            "blocked",
            "ready-for-implementation",
            "implemented"
          ]
        },
        "public_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "summary"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "result_class": { "$ref": "#/$defs/stringOrNull" },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "scope": { "$ref": "#/$defs/functionScope" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/parameter" },
              { "$ref": "#/$defs/inputReference" },
              { "$ref": "#/$defs/localReference" }
            ]
          }
        },
        "outputs": {
          "oneOf": [
            { "$ref": "#/$defs/outputs" },
            { "$ref": "#/$defs/localReference" }
          ]
        },
        "verification_tolerances": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/verificationToleranceOverride" }
        },
        "verification_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationCase" }
        },
        "edge_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgeCase" }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "implementation": { "$ref": "#/$defs/implementation" }
      }
    }
  }
}
