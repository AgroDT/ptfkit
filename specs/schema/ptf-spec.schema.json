{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgroDT/ptfkit/blob/main/specs/schema/ptf-spec.schema.json",
  "title": "PTF source specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "functions"],
  "properties": {
    "source": { "$ref": "#/$defs/source" },
    "scope": { "$ref": "#/$defs/commonScope" },
    "generation": { "$ref": "#/$defs/generation" },
    "scientific_notes": { "type": "string" },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/function" }
    }
  },
  "$defs": {
    "generation": { "type": "object", "additionalProperties": false, "properties": { "public_python": { "enum": ["generated", "manual"], "default": "generated" } } },
    "implementationVariable": { "type": "object", "additionalProperties": false, "required": ["name", "expr"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "expr": { "type": "string", "minLength": 1 } } },
    "implementationField": { "type": "object", "additionalProperties": false, "required": ["name", "expr"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "expr": { "type": "string", "minLength": 1 } } },
    "implementation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["output"], "properties": { "variables": { "type": "array", "default": [], "items": { "$ref": "#/$defs/implementationVariable" } }, "output": { "type": "object", "additionalProperties": false, "required": ["type", "expr"], "properties": { "type": { "const": "scalar" }, "expr": { "type": "string", "minLength": 1 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["output"], "properties": { "variables": { "type": "array", "default": [], "items": { "$ref": "#/$defs/implementationVariable" } }, "output": { "type": "object", "additionalProperties": false, "required": ["type", "fields"], "properties": { "type": { "const": "record" }, "fields": { "type": "array", "items": { "$ref": "#/$defs/implementationField" } } } } } }
      ]
    },
    "stringOrNull": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "citation_apa", "doi"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 100 },
        "citation_apa": { "type": "string", "minLength": 1 },
        "doi": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "url"],
              "properties": {
                "identifier": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "commonScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "dataset": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "functionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_target", "models"],
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "prediction_target": { "type": "string", "minLength": 1 },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["h_theta", "k_h"],
          "properties": {
            "h_theta": { "$ref": "#/$defs/stringOrNull" },
            "k_h": { "$ref": "#/$defs/stringOrNull" }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "unit", "domain", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "$ref": "#/$defs/stringOrNull" },
        "unit": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/stringOrNull" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "goldenTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected", "rtol", "atol", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object", "minProperties": 1 },
        "expected": { "type": "object", "minProperties": 1 },
        "rtol": { "type": "number", "minimum": 0 },
        "atol": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "edgeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected_behavior", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object", "minProperties": 1 },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "public_api",
        "scope",
        "inputs",
        "outputs"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^calc_ptf_[a-z][a-z0-9_]*$" },
        "status": {
          "enum": [
            "draft",
            "blocked",
            "ready-for-implementation",
            "implemented"
          ]
        },
        "public_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "result_class", "summary"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "result_class": { "$ref": "#/$defs/stringOrNull" },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "scope": { "$ref": "#/$defs/functionScope" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "golden_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/goldenTest" }
        },
        "edge_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgeCase" }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "implementation": { "$ref": "#/$defs/implementation" }
      }
    }
  }
}
