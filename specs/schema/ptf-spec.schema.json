{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgroDT/ptfkit/blob/main/specs/schema/ptf-spec.schema.json",
  "title": "PTF source specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "functions"],
  "properties": {
    "source": { "$ref": "#/$defs/source" },
    "scope": { "$ref": "#/$defs/commonScope" },
    "generation": { "$ref": "#/$defs/generation" },
    "$defs": { "$ref": "#/$defs/sourceDefinitions" },
    "scientific_notes": { "type": "string" },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/function" }
    }
  },
  "$defs": {
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_python": {
          "enum": ["generated", "manual"],
          "default": "generated"
        }
      }
    },
    "implementationVariable": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "expr"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "expr": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "lookup"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "lookup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["table", "key"],
              "properties": {
                "table": { "$ref": "#/$defs/localReference" },
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
              }
            }
          }
        }
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variables"],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/implementationVariable" }
        }
      }
    },
    "lookupDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input", "output", "values"],
      "properties": {
        "type": { "const": "lookup" },
        "input": { "$ref": "#/$defs/localReference" },
        "output": { "$ref": "#/$defs/localReference" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lookupValue" }
        }
      }
    },
    "lookupValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "stringOrNull": { "type": ["string", "null"] },
    "localReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9_]*$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "citation_apa", "doi"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 100 },
        "citation_apa": { "type": "string", "minLength": 1 },
        "doi": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "url"],
              "properties": {
                "identifier": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "commonScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "dataset": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "functionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_target", "models"],
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "prediction_target": { "type": "string", "minLength": 1 },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["h_theta", "k_h"],
          "properties": {
            "h_theta": { "$ref": "#/$defs/stringOrNull" },
            "k_h": { "$ref": "#/$defs/stringOrNull" }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "unit", "domain", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "$ref": "#/$defs/stringOrNull" },
        "unit": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/stringOrNull" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "$ref"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "$ref": {
          "type": "string",
          "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9_]*$"
        }
      }
    },
    "enumDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description", "values"],
      "properties": {
        "type": { "const": "enum" },
        "description": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/enumValue" }
        }
      }
    },
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "sourceDefinitions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/enumDefinition" },
          { "$ref": "#/$defs/lookupDefinition" },
          { "$ref": "#/$defs/outputs" },
          { "$ref": "#/$defs/parameter" }
        ]
      }
    },
    "outputs": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "symbol",
            "unit",
            "domain",
            "description"
          ],
          "properties": {
            "type": { "const": "scalar" },
            "name": { "type": "string", "minLength": 1 },
            "symbol": { "$ref": "#/$defs/stringOrNull" },
            "unit": { "type": "string", "minLength": 1 },
            "domain": { "$ref": "#/$defs/stringOrNull" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "fields"],
          "properties": {
            "type": { "const": "record" },
            "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/parameter" }
            }
          }
        }
      ]
    },
    "publishedPrecision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decimal_places"],
          "properties": {
            "decimal_places": { "type": "integer", "minimum": 0, "maximum": 308 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["significant_digits"],
          "properties": {
            "significant_digits": { "type": "integer", "minimum": 1, "maximum": 17 }
          }
        }
      ]
    },
    "verificationCase": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "inputs", "expected", "source_location"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "published" },
            "inputs": { "type": "object", "minProperties": 1 },
            "expected": { "type": "object", "minProperties": 1 },
            "source_location": { "type": "string", "minLength": 1 },
            "precision": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/publishedPrecision" }
            },
            "notes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "inputs", "expected", "rationale"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "calculated" },
            "inputs": { "type": "object", "minProperties": 1 },
            "expected": { "type": "object", "minProperties": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        }
      ]
    },
    "edgeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected_behavior", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object", "minProperties": 1 },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "public_api",
        "scope",
        "inputs",
        "outputs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["ready-for-implementation", "implemented"] }
            }
          },
          "then": { "required": ["implementation"] }
        }
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^calc_ptf_[a-z][a-z0-9_]*$" },
        "status": {
          "enum": [
            "draft",
            "blocked",
            "ready-for-implementation",
            "implemented"
          ]
        },
        "public_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "summary"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "result_class": { "$ref": "#/$defs/stringOrNull" },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "scope": { "$ref": "#/$defs/functionScope" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/parameter" },
              { "$ref": "#/$defs/inputReference" },
              { "$ref": "#/$defs/localReference" }
            ]
          }
        },
        "outputs": {
          "oneOf": [
            { "$ref": "#/$defs/outputs" },
            { "$ref": "#/$defs/localReference" }
          ]
        },
        "verification_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationCase" }
        },
        "edge_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgeCase" }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "implementation": { "$ref": "#/$defs/implementation" }
      }
    }
  }
}
