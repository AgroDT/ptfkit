{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgroDT/ptfkit/blob/main/specs/schema/ptf-spec.schema.json",
  "title": "PTF source specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "functions"],
  "properties": {
    "source": { "$ref": "#/$defs/source" },
    "scope": { "$ref": "#/$defs/commonScope" },
    "generation": { "$ref": "#/$defs/generation" },
    "$defs": { "$ref": "#/$defs/sourceDefinitions" },
    "scientific_notes": { "type": "string" },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/function" }
    }
  },
  "$defs": {
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_python": {
          "enum": ["generated", "manual"],
          "default": "generated"
        }
      }
    },
    "implementationVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expr"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "expr": { "type": "string", "minLength": 1 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variables"],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/implementationVariable" }
        }
      }
    },
    "stringOrNull": { "type": ["string", "null"] },
    "localReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9_]*$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "citation_apa", "doi"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 100 },
        "citation_apa": { "type": "string", "minLength": 1 },
        "doi": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "url"],
              "properties": {
                "identifier": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "commonScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "dataset": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "functionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction_target", "models"],
      "properties": {
        "territory": { "$ref": "#/$defs/stringOrNull" },
        "prediction_target": { "type": "string", "minLength": 1 },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["h_theta", "k_h"],
          "properties": {
            "h_theta": { "$ref": "#/$defs/stringOrNull" },
            "k_h": { "$ref": "#/$defs/stringOrNull" }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "unit", "domain", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "$ref": "#/$defs/stringOrNull" },
        "unit": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/stringOrNull" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "inputParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "unit", "domain", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "not": { "enum": ["scalar", "record"] },
          "default": "number"
        },
        "symbol": { "$ref": "#/$defs/stringOrNull" },
        "unit": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/stringOrNull" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "sourceDefinitions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/inputParameter" },
          { "$ref": "#/$defs/outputs" }
        ]
      }
    },
    "outputs": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "symbol",
            "unit",
            "domain",
            "description"
          ],
          "properties": {
            "type": { "const": "scalar" },
            "name": { "type": "string", "minLength": 1 },
            "symbol": { "$ref": "#/$defs/stringOrNull" },
            "unit": { "type": "string", "minLength": 1 },
            "domain": { "$ref": "#/$defs/stringOrNull" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "fields"],
          "properties": {
            "type": { "const": "record" },
            "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/parameter" }
            }
          }
        }
      ]
    },
    "goldenTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected", "rtol", "atol", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["number", "string"] }
        },
        "expected": { "type": "object", "minProperties": 1 },
        "rtol": { "type": "number", "minimum": 0 },
        "atol": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "edgeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected_behavior", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object", "minProperties": 1 },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "public_api",
        "scope",
        "inputs",
        "outputs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["ready-for-implementation", "implemented"] }
            }
          },
          "then": { "required": ["implementation"] }
        }
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^calc_ptf_[a-z][a-z0-9_]*$" },
        "status": {
          "enum": [
            "draft",
            "blocked",
            "ready-for-implementation",
            "implemented"
          ]
        },
        "public_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "summary"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "result_class": { "$ref": "#/$defs/stringOrNull" },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "scope": { "$ref": "#/$defs/functionScope" },
        "derived_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/derivedInput" }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/inputParameter" },
              { "$ref": "#/$defs/localReference" }
            ]
          }
        },
        "outputs": {
          "oneOf": [
            { "$ref": "#/$defs/outputs" },
            { "$ref": "#/$defs/localReference" }
          ]
        },
        "golden_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/goldenTest" }
        },
        "edge_cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgeCase" }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "implementation": { "$ref": "#/$defs/implementation" }
      }
    },
    "derivedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "input", "evidence", "components"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "input": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
