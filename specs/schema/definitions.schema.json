{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ptfkit shared definitions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$defs"
  ],
  "properties": {
    "$defs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "ptf-spec.schema.json#/$defs/enumDefinition"
      }
    }
  }
}
